<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Doctor</title>

    <style>
        body {
            margin: 0;
            padding: 25px;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #263445;
        }

        .container {
            max-width: 750px;
            margin: 20px auto;
            padding: 28px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 3px 12px #0000000d;
        }

        h1 {
            color: #173b63;
            margin-top: 0;
        }

        .subtitle {
            color: #65758b;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 17px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            font-weight: bold;
        }

        input, select {
            box-sizing: border-box;
            width: 100%;
            padding: 11px;
            border: 1px solid #cbd5e1;
            border-radius: 5px;
            font-size: 15px;
            background: white;
        }

        .actions {
            display: flex;
            gap: 10px;
            margin-top: 25px;
        }

        .button {
            padding: 11px 17px;
            border: none;
            border-radius: 5px;
            text-decoration: none;
            cursor: pointer;
            font-size: 14px;
        }

        .primary {
            background: #1769aa;
            color: white;
        }

        .primary:disabled {
            background: #94a3b8;
            cursor: not-allowed;
        }

        .secondary {
            background: #e7edf4;
            color: #263445;
        }

        .note {
            color: #65758b;
            font-size: 13px;
            margin-top: 5px;
        }
    </style>
</head>

<body>
<div class="container">

    <h1>Register Doctor</h1>

    <p class="subtitle">
        Enter the doctor's professional and contact information.
    </p>

    <form method="post"
          action="${pageContext.request.contextPath}/doctors">

        <!-- Tells DoctorServlet to create a new doctor -->
        <input type="hidden" name="action" value="create">

        <div class="form-group">
            <label for="fullName">Full Name *</label>
            <input type="text" id="fullName" name="fullName"
                   maxlength="120" required>
        </div>

        <div class="form-group">
            <label for="departmentId">Department *</label>

            <select id="departmentId" name="departmentId" required>
                <option value="">-- Select Department --</option>

                <c:forEach var="department" items="${departments}">
                    <option value="${department.departmentId}">
                        <c:out value="${department.departmentName}"/>
                    </option>
                </c:forEach>
            </select>

            <c:if test="${empty departments}">
                <p class="note">
                    No active departments are available. Add or activate
                    a department before registering a doctor.
                </p>
            </c:if>
        </div>

        <div class="form-group">
            <label for="specialization">Specialization *</label>
            <input type="text" id="specialization"
                   name="specialization" maxlength="120"
                   placeholder="e.g. Cardiology" required>
        </div>

        <div class="form-group">
            <label for="qualification">Qualification</label>
            <input type="text" id="qualification"
                   name="qualification" maxlength="200"
                   placeholder="e.g. MBBS, MD">
        </div>

        <div class="form-group">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone"
                   maxlength="20">
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email"
                   maxlength="150">
        </div>

        <div class="actions">
            <button type="submit" class="button primary"
                    <c:if test="${empty departments}">disabled</c:if>>
                Register Doctor
            </button>

            <a class="button secondary"
               href="${pageContext.request.contextPath}/doctors">
                Cancel
            </a>
        </div>

        <p class="note">
            The doctor ID and creation date are generated by the database.
        </p>

    </form>
</div>
</body>
</html>
